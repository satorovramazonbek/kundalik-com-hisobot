BOT_TOKEN=your_bot_token_here
# Faqat shu Telegram ID lar foydalansin (vergul bilan). Bo'sh = hamma.
ALLOWED_USERS=
MAX_PARALLEL=2
# 0 qilsangiz brauzer ko'rinadi (sozlash uchun qulay)
HEADLESS=1
SAVE_DEBUG=1
# Agar hisobot sahifasini avtomatik topa olmasa, aniq URL ni shu yerga yozing:
KUNDALIK_REPORT_URL=
# Hisobot turi: progress-classteacher (Sinf rahbariga), digital-tabel (Elektron tabel), progress-groups, progress-students
REPORT_KEY=progress-classteacher
# Choraklar boshlanish sanasi (OO-KK) va hisobot uchun chorak ichidagi sana (OO-KK)
QUARTER_STARTS=09-02,11-04,01-08,03-28
QUARTER_DATES=10-15,12-15,02-20,04-25
